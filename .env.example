# Set the exact app origin. Use HTTPS in production.
APP_URL=http://localhost:3000
# Use the local Compose database here. Use a managed TLS connection in production.
DATABASE_URL=postgresql://fairstage:fairstage@localhost:5432/fairstage
# Optional direct connection for migrations. Use a pooled connection at runtime.
# Use sslmode=verify-full for both production connection URLs.
DATABASE_DIRECT_URL=
DEFAULT_CURRENCY=INR

# Only verified accounts at these exact addresses can use the operator console.
OPERATOR_EMAILS=
# Use at least 32 random URL-safe characters for the daily maintenance job.
CRON_SECRET=

# Google OAuth web client. Register APP_URL/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use a verified sender for sign-in links, verification, and password reset.
RESEND_API_KEY=
EMAIL_FROM=

# INR checkout and transfers need an activated merchant and Route approval.
# Keep both flags false until the provider acceptance checks pass.
RAZORPAY_PAYMENTS_ENABLED=false
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# USD checkout and transfers need an approved Stripe platform.
LIVE_PAYMENTS_ENABLED=false
# The actual Stripe platform jurisdiction. IN cannot use this separate-transfer flow.
STRIPE_PLATFORM_COUNTRY=
# Set true only after Stripe approves this funds flow and candidate countries.
STRIPE_FUNDS_FLOW_APPROVED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set only the candidate countries that the operator and Stripe approve.
STRIPE_CONNECT_COUNTRIES=

# Optional model service. Use an HTTPS OpenAI-compatible base URL.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
